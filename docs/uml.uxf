Sesion
--
- _canciones_escuchadas: list
- _media_sonora: dict
- _desviacion_sonora: dict
- _media_sentimental: dict
- _desviacion_sentimental: dict
--
#getters
+ get_canciones_escuchadas()
+ get_media_sonora()
+ get_desviacion_sonora()
+ get_media_sentimental()
+ get_desviacion_sentimental()

#setters
+ set_canciones_escuchadas(canciones: list)
+ set_media_sonora(media: dict)
+ set_desviacion_sonora(desviacion: dict)
+ set_media_sentimental(media: dict)
+ set_desviacion_sentimental(desviacion: dict)

+ agregar_cancion(cancion: Cancion)</panel_attributes>
