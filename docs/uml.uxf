    <panel_attributes>&lt;&lt;Clase&gt;&gt;
Cancion
--
- _id_cancion: str
- _titulo: str
- _fecha_creacion: date
- _atributos_sonoros: dict
- _atributos_sentimentales: dict
--
#getters
+ get_id_cancion()
+ get_titulo()
+ get_fecha_creacion()
+ get_atributos_sonoros()
+ get_atributos_sentimentales()

#setters
+ set_id_cancion(id: str)
+ set_titulo(titulo: str)
+ set_fecha_creacion(fecha: date)
+ set_atributos_sonoros(atributos: dict)
+ set_atributos_sentimentales(atributos: dict)</panel_attributes>
    <additional_attributes/>
  </element>
